{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The portfolio's shared configuration, extended by name: the timezone, the Monday schedule, the
  // limits, `platformAutomerge: false`, the kotlin/kotlinx/sborka/ci-actions groups and majors going
  // to a human were identical in ten repositories and now live in sborka.
  //
  // The automerge preset is extended second on purpose — its rule has to land after the base
  // preset's "majors get a human" to override it for the harness — and its precondition holds
  // here: ci.yaml runs on `pull_request`.
  extends: [
    "github>youndie/sborka",
    "github>youndie/sborka:automerge-harness",
  ],

  // Below the extends, so these win: package rules are concatenated, preset first, and the last
  // match takes effect. Note what this means for Ktor: the preset says nothing about it, and the
  // rules below take it out of anything that could merge it unread.
  packageRules: [
    {
      // The reason this rule exists is specific to this library: `ktor-client-curl` links libcurl
      // and OpenSSL statically inside its cinterop klib, so the TLS stack is whatever Ktor shipped
      // (docs/research/research-architecture.md, fact 1.1 and risk 1). A Ktor bump is a TLS bump,
      // and a CVE fix in OpenSSL arrives only this way — which is exactly why it wants a human
      // reading it rather than a merge, and its own branch rather than a ride along with kotlinx.
      description: "Ktor carries the TLS stack: check which OpenSSL the new version bundles",
      matchPackageNames: ["/^io\\.ktor[:.]/"],
      groupName: "ktor",
      automerge: false,
      labels: ["dependencies", "tls"],
    },
    {
      // `strings` over `libcrypto.a` inside the cinterop klib is the only way to read it, and the
      // README states the version, so a bump that nobody checked leaves the README lying.
      description: "Ktor: say what to check before merging",
      matchPackageNames: ["/^io\\.ktor[:.]/"],
      prBodyNotes: [
        ":warning: Ktor bundles libcurl and OpenSSL statically, so this is also a TLS bump. Read the version out of the new klib before merging, and update the README if it changed:",
        "```sh\nunzip -p ~/.gradle/caches/modules-2/files-2.1/io.ktor/ktor-client-curl-linuxx64/*/*/*-cinterop-libcurl.klib default/targets/linux_x64/included/libcrypto.a | strings | grep -oE 'OpenSSL [0-9.]+[a-z]?' | sort -u\n```",
      ],
    },
    {
      // The tag is pinned because MinIO's `latest` stopped moving on 2025-09-07, so following it
      // would neither give updates nor stay honest about what is being tested. A new release is
      // worth knowing about; taking it is a decision, and the whole suite gets re-run after.
      description: "The test server is pinned deliberately — a new tag is a decision, not a bump",
      matchManagers: ["docker-compose"],
      automerge: false,
      additionalBranchPrefix: "minio-",
      labels: ["dependencies", "test server"],
    },
    {
      description: "Base images: changing the distro under a native binary is a decision, not a bump",
      matchManagers: ["dockerfile"],
      automerge: false,
      // Own branch, so the image never rides along with anything else.
      additionalBranchPrefix: "docker-",
    },
    // NO KTLINT RULE HERE, AND THAT IS NOT AN OVERSIGHT — nor is one inherited from the preset,
    // which says nothing about ktlint either. This repository declares no ktlint version anywhere:
    // `sborka.lint` applies the plugin and pins the tool for the whole portfolio, so what
    // build.gradle.kts spells is its configuration block, not a dependency. A rule matching
    // `com.pinterest.ktlint` here would match nothing while reading like protection — checked by
    // extracting this repository and testing the rule against what came out.
  ],
}
